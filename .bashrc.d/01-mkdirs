# vim: ft=bash

HISTORIES=()
HISTORIES+=("bash")
HISTORIES+=("less")
HISTORIES+=("python")
HISTORIES+=("vim")

for h in ${HISTORIES[@]}; do
  if ! [ -d "${XDG_STATE_HOME}/$h" ]; then
    mkdir "${XDG_STATE_HOME}/$h"
  fi
done

if ! [ -d ${XDG_BIN_HOME} ]; then
  mkdir ${XDG_BIN_HOME}
fi

if ! [ -d ${XDG_CONFIG_HOME}/netrc ]; then
  mkdir ${XDG_CONFIG_HOME}/netrc
fi
